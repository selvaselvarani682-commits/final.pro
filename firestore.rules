rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidReview(data) {
      return data.id is string
        && data.productId is string
        && data.productTitle is string
        && data.reviewerName is string
        && data.platform in ['Amazon', 'Meesho', 'Myntra', 'Nykaa', 'Snapdeal']
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.content is string && data.content.size() > 0 && data.content.size() <= 5000
        && data.sentiment in ['Positive', 'Negative', 'Neutral', 'Mixed']
        && data.createdAt is string;
    }

    match /reviews/{reviewId} {
      // Anyone can read customer reviews in the open catalog
      allow read: if true;
      
      // Anyone can submit genuine verified reviews or add customer feedback
      allow create: if isValidReview(request.resource.data) && request.resource.data.id == reviewId;
      
      // Update allowed if payload remains valid
      allow update: if isValidReview(request.resource.data);

      // Deletion of review
      allow delete: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
